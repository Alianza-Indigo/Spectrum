# =============================================================================
# SPECTRUM Agencia de Inteligencia — variables de entorno
# Copia este archivo a `.env` (o configúralas en Vercel) y completa los valores.
# NUNCA subas secretos al repositorio: viven solo en variables de entorno.
# =============================================================================

# URL pública de la aplicación (sin barra final).
APP_URL="http://localhost:3000"

# Secreto para firmar sesiones/tokens. Genera con: openssl rand -base64 32
AUTH_SECRET=""

# PostgreSQL serverless (Neon, Supabase, Vercel Postgres, etc.).
DATABASE_URL="postgresql://user:password@host:5432/spectrum?sslmode=require"

# Almacenamiento de objetos privado para evidencia (S3 compatible / R2 / Blob).
STORAGE_PROVIDER="s3"
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

# Correo transaccional (Resend, Postmark, SES, etc.).
EMAIL_PROVIDER="resend"
EMAIL_API_KEY=""

# Proveedor de IA por defecto (adaptadores intercambiables).
# Por defecto: Google Gemini 3.1 Flash Lite.
AI_DEFAULT_PROVIDER="gemini"
AI_DEFAULT_MODEL="gemini-3.1-flash-lite"
GEMINI_API_KEY=""
# Alternativas opcionales:
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# Secreto para autenticar la ejecución de cron/jobs (Vercel Cron).
CRON_SECRET=""

# Clave para cifrado de campos sensibles en reposo. openssl rand -base64 32
ENCRYPTION_KEY=""

# Proveedor de generación de PDF (serverless / externo).
PDF_PROVIDER="serverless"
